# Python-generated files
**/__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# coding agents (ignore personal configs)
.gemini/
.claude/
.cursor/

# demo client config examples are tracked (the rule above targets local CLI state)
!docs/demo/.gemini/
!docs/demo/.codex/
