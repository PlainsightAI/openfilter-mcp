# Python-generated files
**/__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# coding agents (ignore personal configs)
.gemini/
.claude/
.cursor/
.codex/

# demo client config examples are tracked (the rules above target local CLI state).
# One negation per base rule: without .codex/ above, its negation matched nothing,
# and without these two, docs/demo/.claude/ and docs/demo/.cursor/ stayed ignored
# and were only tracked because they predate the rules.
!docs/demo/.gemini/
!docs/demo/.codex/
!docs/demo/.claude/
!docs/demo/.cursor/
